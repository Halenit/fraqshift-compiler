sys.clear
sys.flush_key

; 1. ALLOCATE THREE INDEPENDENT VARIABLE CELLS (SIMULATING THE CHIPS)
var char_one = 73       ; ASCII for 'I'
var char_two = 78       ; ASCII for 'N'
var char_three = 67     ; ASCII for 'C'

; 2. STREAM THE CHARACTERS DIRECTLY VIA REGISTER STACK PUSHES
data.var char_one
sys.print_char

data.var char_two
sys.print_char

data.var char_three
sys.print_char

; 3. HARDWARE PAUSE
sys.read_key

