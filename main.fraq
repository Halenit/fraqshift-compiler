sys.clear
sys.flush_key

; 1. ALLOCATE ARRAY WITH 5 SLOTS
var.array my_list[5]

; 2. WRITE VALUES DIRECTLY INTO DIFFERENT KISEL-NODES
my_list[0] = 42
my_list[1] = 99

; 3. FETCH ELEMENT AT INDEX 1 (Should print 99)
data.array my_list[1]
sys.print_int

; 4. HARDWARE PAUSE
sys.read_key
