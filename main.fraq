sys.clear
sys.flush_key

; ==============================================================================
; 1. MAIN PROGRAM EXECUTION FLOW (The Code Generator Final Test)
; ==============================================================================
; Skapa en fast global adress (329000)
var output_ptr = 329000

; CRITICAL FIX: Ladda talet 33 (Utropstecknet '!') direkt i RAX-registret
; eftersom det är därifrån skriv-parsern hämtar datat vid pekaravrefereringen!
sys.reg rax = 33
*output_ptr = rax

; ==============================================================================
; 2. VERIFIERING: HÄMTA VÄRDET OCH STRÖMMA UT DET PÅ SKÄRMEN
; ==============================================================================
; Skapa en ny, ren variabel på stacken som ska hålla vårt resultat
var result_val = 0

; Läs av byten från RAM-minnet via vår uppdaterade byte-peek
data.peek output_ptr

; Poppa värdet direkt från beräkningsstacken in i vår rena variabel
result_val = rax

; Skapa vår skärmpekare för rad 5 (754304)
var row_five_ptr = 754304

; Hämta det isolerade värdet från vår rena variabel och tryck ut på skärmen
data.var result_val
*row_five_ptr = rax

; Sätt färgattributet till ljusgrön (10) på nästa byte i VGA för maximal AI-glans
sys.inc row_five_ptr
*row_five_ptr = 10

; Hardware pause
sys.read_key
