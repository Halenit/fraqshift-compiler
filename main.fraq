sys.clear
sys.flush_key

; 1. DECLARE A HARDWARE SUBROUTINE
func void print_success
    sys.clear
    data.int 777
    sys.print_int
func_done

; 2. MAIN EXECUTION FLOW - CALL THE FUNCTION DIRECTLY
sys.call print_success

; 3. HARDWARE PAUSE TO ADMIRE THE WORK
sys.read_key

