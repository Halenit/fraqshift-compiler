sys.clear
sys.flush_key

; 1. DECLARE INITIAL VARIABLE AND INCREMENT IT FROM 50 TO 51 DIRECTLY IN RAM
var test_val = 50
sys.inc test_val

; 2. DEFINE RAM DESTINATION POINTER FOR SCREEN ROW 3 (0xB8140 = 753984)
var screen_ptr = 753984

; 3. COMPARE TEST_VAL WITH 50
data.var test_val
sys.cmp 50

sys.if_eq
    ; This block should be SKIPPED because test_val is now 51!
    *screen_ptr = 65    ; ASCII for 'A'
sys.else
    ; KISEL-SUCCESS: The processor jumps straight here!
    *screen_ptr = 67    ; ASCII for 'C'
sys.if_done

; 4. HARDWARE PAUSE
sys.read_key

