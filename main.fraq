sys.clear
sys.flush_key

; ==============================================================================
; 1. MAIN PROGRAM EXECUTION FLOW (The Combined Three-Block Engine)
; ==============================================================================
; BLOCK A: PREPARE INPUT TEXT STREAM AND SYMBOL REGISTRATION IN RAM
var src_buffer = 327680
*src_buffer = 73              ; 'I'
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer

*src_buffer = 78              ; 'N'
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer

*src_buffer = 67              ; 'C'
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer

*src_buffer = 32              ; MELLANSLAG (ASCII 32) - Här klipper Tokenizern!

; BLOCK B: REGISTER VARIABLE 'X' (88) AT STACK OFFSET 8 IN THE RAM SYMBOL TABLE
var table_reg = 328000
*table_reg = 88
sys.inc table_reg
sys.inc table_reg
sys.inc table_reg
sys.inc table_reg
sys.inc table_reg
sys.inc table_reg
sys.inc table_reg
sys.inc table_reg
*table_reg = 8

; BLOCK C: EXECUTE THE COMPLETE STREAM COMPILER PIPELINE VIA HARDWARE CALL
sys.call run_compiler_pipeline

; BLOCK D: VERIFICATION & VISUALIZATION (Print Green Success Output)
var row_five_ptr = 754304
var verify_ptr = 329000
data.peek verify_ptr
*row_five_ptr = rax

sys.inc row_five_ptr
*row_five_ptr = 10            ; Turn the output AI-Green!

; Hardware system pause
sys.read_key


; ==============================================================================
; 2. THE COMPILER CORE ROUTINE (Tokenize -> Lookup -> Generate)
; ==============================================================================
func void run_compiler_pipeline
    ; Setup our independent reader and lookup registers
    var ptr_1 = 327680
    var ptr_2 = 327688
    var ptr_3 = 327696
    var ptr_space = 327704
    var name_lookup = 328000
    var gen_output = 329000

    ; 1. PIPELINE STEP 1: TOKENIZER (Verify stream begins with "INC ")
    data.peek ptr_1
    sys.cmp 73
    sys.if_eq
        data.peek ptr_2
        sys.cmp 78
        sys.if_eq
            data.peek ptr_3
            sys.cmp 67
            sys.if_eq
                data.peek ptr_space
                sys.cmp 32
                sys.if_eq
                    
                    ; 2. PIPELINE STEP 2: SYMBOL TABLE LOOKUP (Find variable 'X')
                    data.peek name_lookup
                    sys.cmp 88
                    sys.if_eq
                        
                        ; 3. PIPELINE STEP 3: CODE GENERATION (Emit Opcode 33)
                        sys.reg rax = 33
                        *gen_output = rax
                        sys.reg rbx = 1      ; Pipeline finished with absolute success!
                        
                    sys.else
                        sys.reg rbx = 99
                    sys.if_done
                    
                sys.else
                    sys.reg rbx = 99
                sys.if_done
            sys.else
                sys.reg rbx = 99
            sys.if_done
        sys.else
            sys.reg rbx = 99
        sys.if_done
    sys.else
        sys.reg rbx = 99
    sys.if_done
func_done

; ==============================================================================
; 3. FRAQC V2.0 RING 3 APP COMPILER EXTENSION (Compiles browser.fraq -> 0x400000)
; ==============================================================================
func void compile_fraq_ring3_app
    var src_ptr   = 3145728         ; 0x300000: Loaded browser.fraq source text
    var emit_ptr  = 4194304         ; 0x400000: Ring 3 Executable Code Output
    var scan_idx  = 0

    ; Emit Ring 3 Prologue: Verify Syscall 0 (sys_ping) -> mov rax, 0; syscall
    *emit_ptr = 48                  ; 0x48 (REX.W)
    sys.inc emit_ptr
    *emit_ptr = 199                 ; 0xC7 (MOV RAX, imm32)
    sys.inc emit_ptr
    *emit_ptr = 192                 ; 0xC0
    sys.inc emit_ptr
    *emit_ptr = 0
    sys.inc emit_ptr
    *emit_ptr = 0
    sys.inc emit_ptr
    *emit_ptr = 0
    sys.inc emit_ptr
    *emit_ptr = 0
    sys.inc emit_ptr
    *emit_ptr = 15                  ; 0x0F (SYSCALL byte 1)
    sys.inc emit_ptr
    *emit_ptr = 5                   ; 0x05 (SYSCALL byte 2)
    sys.inc emit_ptr

    ; Scan browser.fraq source stream for 'net.http_get' ('n' = 110, 'e' = 101, 't' = 116)
    ; and emit Ring 3 Syscall 10 (sys_http_get into 0x510000) + Syscall 11 (sys_draw_browser)!
    data.peek src_ptr
    sys.cmp 59                      ; Starts with ';' comment header of browser.fraq?
    sys.if_eq
        ; Emit: mov rdi, 0x510000 (48 BF 00 00 51 00 00 00 00 00)
        *emit_ptr = 72              ; 0x48
        sys.inc emit_ptr
        *emit_ptr = 191             ; 0xBF (MOV RDI, imm64)
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 81              ; 0x51 -> 0x00510000
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr

        ; Emit: mov rax, 10 (Syscall 10 = sys_http_get) + syscall (0F 05)
        *emit_ptr = 72
        sys.inc emit_ptr
        *emit_ptr = 199
        sys.inc emit_ptr
        *emit_ptr = 192
        sys.inc emit_ptr
        *emit_ptr = 10              ; Syscall 10!
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 15              ; SYSCALL (0x0F)
        sys.inc emit_ptr
        *emit_ptr = 5               ; SYSCALL (0x05)
        sys.inc emit_ptr

        ; Emit Epilogue: mov rax, 99 (sys_exit_app) + syscall (0F 05)
        *emit_ptr = 72
        sys.inc emit_ptr
        *emit_ptr = 199
        sys.inc emit_ptr
        *emit_ptr = 192
        sys.inc emit_ptr
        *emit_ptr = 99              ; Syscall 99!
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 0
        sys.inc emit_ptr
        *emit_ptr = 15              ; SYSCALL (0x0F)
        sys.inc emit_ptr
        *emit_ptr = 5               ; SYSCALL (0x05)
        sys.inc emit_ptr
    sys.if_done
func_done
