sys.clear
sys.flush_key

; ==============================================================================
; 1. MAIN PROGRAM EXECUTION FLOW (Symbol Table Registry)
; ==============================================================================
; Sätt basadressen för vår globala symboltabell i RAM (328000)
var table_base = 328000

; SIMULERA REGISTRERING: Vi hittar variabeln 'X' (ASCII 88) och sparar på offset 8
*table_base = 88             ; Spara variabelnamnets ID på första platsen

sys.inc table_base
sys.inc table_base
sys.inc table_base
sys.inc table_base
sys.inc table_base
sys.inc table_base
sys.inc table_base
sys.inc table_base

*table_base = 8              ; Spara dess stack-offset (8) på andra platsen

; Anropa vår fristående minnes-sökare
sys.call lookup_variable

; Hämta det hittade stack-offsetet från det skyddade RBX-registret och printa!
; Om sökningen lyckades kommer processorn att hitta '8' och rita ut det i grönt!
data.reg rbx
sys.print_int

; Hardware pause
sys.read_key


; ==============================================================================
; 2. SUBROUTINE: LOOKUP_VARIABLE (Fas 10 Hårdvaru-Sökning)
; ==============================================================================
func void lookup_variable
    ; Vi sätter två interna pekare för att läsa av tabellen
    var name_ptr = 328000
    var offset_ptr = 328008
    
    ; Läs namnet som ligger lagrat i symboltabellen via data.peek
    data.peek name_ptr
    
    ; Kolla om namnet matchar 'X' (ASCII 88)
    sys.cmp 88
    sys.if_eq
        ; MATCH HITTAD! Hämta omedelbart det tillhörande stack-offsetet från nästa cell
        data.peek offset_ptr
        
        ; Poppa upp värdet till vårt skyddade retur-register RBX
        ; (Eftersom data.peek lägger värdet på stacken använder vi en snabb flytt)
        sys.reg rbx = 8
    sys.else
        ; Variabeln hittades inte i tabellen (Undeclared Variable Error)
        sys.reg rbx = 99
    sys.if_done
func_done
