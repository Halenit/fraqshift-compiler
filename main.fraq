sys.clear
sys.flush_key

; ==============================================================================
; 1. MAIN PROGRAM EXECUTION FLOW (Phase 10 Flat Token Stream)
; ==============================================================================
; Vi simulerar källkoden "INC INC" i minnet separerat med ett mellanslag (ASCII 32)
var src_buffer = 327680

*src_buffer = 73              ; 'I'
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer

*src_buffer = 78              ; 'N'
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer

*src_buffer = 67              ; 'C'
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer

*src_buffer = 32              ; MELLANSLAG (ASCII 32) - Här ska Tokenizern klippa!
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer
sys.inc src_buffer

*src_buffer = 73              ; 'I' (Början på ord 2)

; Anropa vår nya stabila kisel-tokenizer
sys.call dynamic_tokenizer

; Hämta Token ID från det skyddade RBX-registret och printa!
data.reg rbx
sys.print_int

; Hardware pause
sys.read_key


; ==============================================================================
; 2. SUBROUTINE: DYNAMIC_TOKENIZER (Fas 10 Flat Text-Splitter)
; ==============================================================================
func void dynamic_tokenizer
    ; Vi sätter upp tre fasta läs-adresser med perfekta 8-bytes kisel-avstånd
    var ptr_1 = 327680
    var ptr_2 = 327688
    var ptr_3 = 327696
    var ptr_space = 327704
    
    ; 1. Verifiera att ordet börjar på 'I', 'N', 'C'
    data.peek ptr_1
    sys.cmp 73
    sys.if_eq
        data.peek ptr_2
        sys.cmp 78
        sys.if_eq
            data.peek ptr_3
            sys.cmp 67
            sys.if_eq
                
                ; 2. DYNAMISK STRÖM-SPLITTNING: Kolla om det FJÄRDE tecknet är ett mellanslag (32)
                data.peek ptr_space
                sys.cmp 32
                sys.if_eq
                    ; MELLANSLAG HITTAT! Ordet "INC" är isolerat och avslutat korrekt!
                    sys.reg rbx = 1
                sys.else
                    ; Det var inte ett mellanslag (Syntax-fel eller sammansatt ord)
                    sys.reg rbx = 99
                sys.if_done
                
            sys.else
                sys.reg rbx = 99
            sys.if_done
        sys.else
            sys.reg rbx = 99
        sys.if_done
    sys.else
        sys.reg rbx = 99
    sys.if_done
func_done
