; ===================================================
; FRAQSHIFT OS - MULTI-STAGE HARDWARE INTEGRATION
; ===================================================

; 1. CLEAR TERMINAL GRAPHICS BUFFER
sys.clear

; 2. FLUSH ALL OLD BIOS KEYBOARD DATA BEFORE STARTING
sys.flush_key

; 3. EXECUTE THE SILICON LOOP (Print 5 green characters to VGA)
data.int 5
sys.loop
    data.int 88             ; ASCII value 88 is the character 'X'
    sys.print_char
sys.loop_end

; 4. HARDWARE PAUSE: The processor will freeze here until you press a key!
sys.read_key

; 5. SYSTEM LOGIC & VILLKORSTEST (Calculates 50 * 2 = 100)
var base_value = 50
data.var base_value
sys.mul 2

sys.cmp 100
sys.if_eq
    ; Clear screen again to show the final message cleanly
    sys.clear
    data.string "FRAQSHIFT OS: Loop, key-flush, and decision engines are fully operational!"
    sys.out
sys.if_done
