sys.clear
sys.flush_key

; 1. Direct register load
sys.reg rcx = 66

; 2. Define memory pointer for screen line 2
var target_ptr = 753824

; 3. Write directly from register to RAM
*target_ptr = rcx

; 4. Hardware pause
sys.read_key

