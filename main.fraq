sys.clear
sys.flush_key

; ==============================================================================
; 1. MAIN PROGRAM EXECUTION FLOW
; ==============================================================================
var addr_one = 327680       ; Adress för 'I'
var addr_two = 327936       ; Adress för 'N'
var addr_three = 328192     ; Adress för 'C'

; Skriv bokstäverna direkt till sina isolerade globala RAM-celler
*addr_one = 73              ; 'I'
*addr_two = 78              ; 'N'
*addr_three = 67            ; 'C'

; Anropa vår fristående hårdvaru-tokenizer
sys.call tokenize_word

; Hämta det returnerade Token ID direkt från det skyddade RBX-registret och printa!
data.reg rbx
sys.print_int

; Hardware pause
sys.read_key


; ==============================================================================
; 2. SUBROUTINE: TOKENIZE_WORD (Flagg-säkrad Kisel-Utvärderare för Fas 9)
; ==============================================================================
func void tokenize_word
    var ptr_one = 327680
    var ptr_two = 327936
    var ptr_three = 328192
    
    ; --- KOLLA BOKSTAV 1 ('I' = 73) ---
    data.peek ptr_one
    sys.cmp 73
    sys.if_eq
        ; CRITICAL FIX: Inga sys.pop här som förstör flaggregistret!
        
        ; --- KOLLA BOKSTAV 2 ('N' = 78) ---
        data.peek ptr_two
        sys.cmp 78
        sys.if_eq
            
            ; --- KOLLA BOKSTAV 3 ('C' = 67) ---
            data.peek ptr_three
            sys.cmp 67
            sys.if_eq
                ; FULLSTÄNDIG MATCH: Texten i globala RAM var exakt "INC"! Sätt ID 1 i RBX!
                sys.reg rbx = 1
            sys.else
                sys.reg rbx = 99
            sys.if_done
        sys.else
            sys.reg rbx = 99
        sys.if_done
    sys.else
        sys.reg rbx = 99
    sys.if_done
func_done
