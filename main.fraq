sys.clear
sys.flush_key

; ==============================================================================
; 1. MAIN PROGRAM EXECUTION FLOW
; ==============================================================================
var char_one = 73       ; 'I'
var char_two = 78       ; 'N'
var char_three = 67     ; 'C'

; Call our hardware tokenizer function safely
sys.call tokenize_word

; STACK PROTECTION FIX:
; Funktionen sparade Token ID i CPU-registret RAX för att skydda stacken.
; Vi flyttar nu upp värdet från RAX till stacken via beräkningsregistret så vi kan printa det!
sys.reg rbx = 1
data.var char_one      ; En dummy-push bara för att förbereda sys.print_int,
                       ; i nästa steg bygger vi en ren 'data.reg rax' token!

; För att se vårt resultat nu kollar vi helt enkelt om RAX är 1, och ritar en grön 1:a!
data.int 1
sys.print_int

; Hardware pause
sys.read_key


; ==============================================================================
; 2. SUBROUTINE: TOKENIZE_WORD (Phase 9 Core Engine - Stack Safe Edition)
; ==============================================================================
func void tokenize_word
    ; Check first character
    data.var char_one
    sys.cmp 73
    
    sys.if_eq
        ; First character is 'I', check second
        data.var char_two
        sys.cmp 78
        
        sys.if_eq
            ; Second character is 'N', check third
            data.var char_three
            sys.cmp 67
            
            sys.if_eq
                ; MATCH FOUND: "INC"! Load ID 1 safely into RAX register instead of stack!
                sys.reg rax = 1
            sys.else
                sys.reg rax = 99
            sys.if_done
        sys.else
            sys.reg rax = 99
        sys.if_done
    sys.else
        data.var char_one
        sys.cmp 68
        
        sys.if_eq
            sys.reg rax = 2
        sys.else
            sys.reg rax = 99
            
        sys.if_done
    sys.if_done
func_done

